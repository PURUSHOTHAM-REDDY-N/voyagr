# Do not wrap values in quotes below - dotenv (used by `next dev`) strips
# them, but Docker's env_file mechanism does not, so a quoted value like
# DATABASE_URL="mongodb://..." reaches the container as a literal string
# starting with a `"` character and fails Prisma's URL validation.

# MongoDB (Prisma)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/voyagr?retryWrites=true&w=majority

# Public URLs
NEXT_PUBLIC_HOSTING_URL=https://your-hosting-url.example.com

# Cloudflare R2 (plan images, S3-compatible)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_S3_BUCKET=your_r2_bucket_name
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret

# Local AI Model (Ollama) - itinerary generation
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Unsplash Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Places API Key (server-side only - not exposed to the browser).
# Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY above if unset, but that key
# is usually HTTP-referrer restricted for browser use; since this is called
# server-to-server, prefer a separate key here restricted by IP (or
# unrestricted) instead. Enable "Places API (New)" for whichever key you use -
# note its Text Search calls with regularOpeningHours are billed at the Pro
# SKU tier, not the cheaper Essentials tier.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# SMTP (invite emails, via Nodemailer) - e.g. Gmail: smtp.gmail.com, port 587,
# an App Password (not your account password) as SMTP_PASSWORD.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Voyagr <your_smtp_username>

# OpenWeatherMap API Key
OPEN_WEATHER_MAP_API_KEY=your_openweathermap_api_key

